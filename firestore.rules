rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 1. ADMIN HELPER (صلاحيات الإدارة)
    // =====================================================
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'WZcxWpG1PLgQYbnegHndxlrxHVx2';
    }

    // =====================================================
    // 2. DAILY HADITHS (الأحاديث النبوية المعتمدة)
    // =====================================================
    match /dailyHadiths/{hadithId} {
      // قراءة الأحاديث متاحة للجميع
      allow read: if true;

      // إضافة أو تعديل أو حذف الأحاديث من الإدارة فقط
      allow write: if isAdmin();
    }

    // =====================================================
    // 3. PRACTICES (السنن والآداب النبوية)
    // =====================================================
    match /practices/{practiceId} {
      // قراءة السنن والآداب متاحة للجميع
      allow read: if true;

      // إضافة أو تعديل أو حذف السنن من الإدارة فقط
      allow write: if isAdmin();
    }

    // =====================================================
    // 4. DAILY PROGRESS (سجلات إنجاز الطلاب اليومية)
    // =====================================================
    match /dailyProgress/{progressId} {
      // الطالب يقرأ سجله فقط، والإدارة تقرأ سجلات الجميع (للوحة الإدارة ومصفوفة الإنجاز)
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);

      // الطالب يسجل ويعدل إنجازه الخاص فقط، والإدارة تستطيع الكتابة للجميع
      allow create, update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid
      );
    }

    // توافقية إضافية مع مجموعة progress
    match /progress/{progressId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create, update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || (
        request.auth != null &&
        resource.data.userId == request.auth.uid
      );
    }

    // =====================================================
    // 5. USERS (ملفات وحسابات المستخدمين والطلاب)
    // =====================================================
    match /users/{userId} {
      // كل مستخدم يقرأ ملفه فقط، والإدارة تقرأ ملفات الجميع (لعرض أسماء الطلاب في لوحة الإدارة)
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);

      // إنشاء الحساب متاح للمستخدم نفسه أو الإدارة
      allow create: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId
      );

      // تحديث الحساب:
      // الإدارة لها صلاحية تعديل جميع الحقول بما فيها الاسم وحالة التأكيد
      // الطالب: يُسمح له بتأكيد اسمه لمرة واحدة فقط إذا لم يكن مؤكداً
      // وبمجرد تأكيد الاسم (nameConfirmed == true) يُمنع الطالب تماماً على مستوى الـ Backend من تغيير اسمه
      allow update: if isAdmin() || (
        request.auth != null &&
        request.auth.uid == userId &&
        (
          // الحالة 1: الطالب لم يؤكد اسمه بعد، مسموح له بتأكيد اسمه وتعيين nameConfirmed: true
          (!('nameConfirmed' in resource.data) || resource.data.nameConfirmed != true)
          ||
          // الحالة 2: الطالب أكد اسمه مسبقاً، يُمنع تماماً من تغيير حقل الاسم name أو تغيير nameConfirmed
          (
            resource.data.nameConfirmed == true &&
            request.resource.data.name == resource.data.name &&
            request.resource.data.nameConfirmed == true
          )
        )
      );

      // حذف الحساب متاح للإدارة فقط
      allow delete: if isAdmin();
    }

    // =====================================================
    // 6. STUDENTS (هيكل توافقي مع الطلاب و subcollections)
    // =====================================================
    match /students/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      match /{subcollection}/{documentId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
    }

    // =====================================================
    // 7. ADMIN DATA & SETTINGS
    // =====================================================
    match /admin/{documentId} {
      allow read, write: if isAdmin();
    }

    match /adminSettings/{documentId} {
      allow read, write: if isAdmin();
    }

    // =====================================================
    // 8. DEFAULT DENY
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
