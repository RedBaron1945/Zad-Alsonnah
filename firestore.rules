rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // 1. ADMIN HELPER (صلاحيات الإدارة)
    // =====================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin = the fixed program-admin UID only. No email matching of any
    // kind — an email must never grant admin rights.
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'WZcxWpG1PLgQYbnegHndxlrxHVx2';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =====================================================
    // 2. DAILY HADITHS (الأحاديث النبوية المعتمدة)
    // =====================================================
    match /dailyHadiths/{hadithId} {
      // القراءة للمستخدمين المسجّلين فقط (طلاب وإدارة)
      allow read: if isAuthenticated();

      // الإضافة والتعديل والحذف من الإدارة فقط
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // 3. PRACTICES (السنن والآداب النبوية)
    // =====================================================
    match /practices/{practiceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // 4. DAILY PROGRESS (سجلات إنجاز الطلاب اليومية)
    // =====================================================
    match /dailyProgress/{progressId} {
      // الطالب يقرأ سجله فقط، والإدارة تقرأ سجلات الجميع (للوحة الإدارة)
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // الطالب يسجل/يعدّل/يحذف إنجازه الخاص فقط، والإدارة لها الصلاحية الكاملة
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // توافقية إضافية مع مجموعة progress القديمة (نفس القواعد)
    match /progress/{progressId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if (isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // =====================================================
    // 5. USERS (ملفات وحسابات المستخدمين والطلاب)
    // =====================================================
    match /users/{userId} {
      // كل مستخدم يقرأ ملفه فقط، والإدارة تقرأ ملفات الجميع (للوحة الإدارة)
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student' || isAdmin())
      ) || isAdmin();

      allow update: if (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId)
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // =====================================================
    // 6. STUDENTS (هيكل توافقي مع الطلاب و subcollections)
    // =====================================================
    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin() || isOwner(uid);

      match /{subcollection}/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isAdmin() || isOwner(uid);
      }
    }

    // =====================================================
    // 7. ADMIN DATA & SETTINGS
    // =====================================================
    match /admin/{documentId} {
      allow read, write: if isAdmin();
    }

    match /adminSettings/{documentId} {
      allow read, write: if isAdmin();
    }

    // =====================================================
    // 8. DEFAULT DENY
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
